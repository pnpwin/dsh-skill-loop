{
  "name": "@pnpwin/dsh-skill-loop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Native ReAct + ACE-lite skill learning with typed entry deltas, bounded reflection, reviewed or soft-auto publication and versioned rollback for DSH.",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./src/icon.svg",
    "./optimizer": "./src/optimizer.js",
    "./bench": "./src/bench/index.js"
  },
  "files": ["src/**/*.js", "src/icon.svg", "locale/*.json", "cordis.patch.yml", "README.md", "README.ru.md", "docs/*.md", "LICENSE", "UPSTREAM.md"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/pnpwin/dsh-skill-loop.git" },
  "homepage": "https://github.com/pnpwin/dsh-skill-loop#readme",
  "bugs": { "url": "https://github.com/pnpwin/dsh-skill-loop/issues" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": ">=22", "dsh": "0.2.2-rc.1" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node src/check-package.js",
    "check": "node src/check-package.js",
    "pack:release": "node src/check-package.js --pack"
  }
}
